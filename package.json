{
  "name": "octotasks",
  "version": "1.0.0",
  "description": "A simple task-manager web app used in the GitHub Developer Training course",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "lint": "eslint src/ tests/"
  },
  "keywords": ["github", "training", "tasks"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.js"]
  }
}
